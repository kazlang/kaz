{
    "Main Function": {
        "prefix": "main",
        "body": [
            "function Main() {",
            "\t$0",
            "}"
        ],
        "description": "Função de entrada Main() da linguagem Kaz"
    },
    "Function Declaration": {
        "prefix": "fn",
        "body": [
            "function ${1:nome}(${2:params}) {",
            "\t$0",
            "}"
        ],
        "description": "Declaração de função em Kaz"
    },
    "Function with Return Type": {
        "prefix": "fnret",
        "body": [
            "function ${1:nome}(${2:params}): ${3:tipo} {",
            "\t$0",
            "\treturn ${4:valor};",
            "}"
        ],
        "description": "Declaração de função com tipo de retorno"
    },
    "Struct Definition": {
        "prefix": "struct",
        "body": [
            "struct ${1:Nome} {",
            "\t${2:tipo} ${3:campo};",
            "\t$0",
            "}"
        ],
        "description": "Definição de estrutura de dados (struct)"
    },
    "Enum Definition": {
        "prefix": "enum",
        "body": [
            "enum ${1:NomeEnum} {",
            "\t${2:Variante},",
            "\t$0",
            "}"
        ],
        "description": "Definição de Enum com dados (Tagged Union) em Kaz"
    },
    "Match Statement": {
        "prefix": "match",
        "body": [
            "match (${1:expressao}) {",
            "\t${2:Padrao} => {",
            "\t\t$0",
            "\t},",
            "\t_ => {",
            "\t}",
            "}"
        ],
        "description": "Correspondência de padrões (match) em Kaz"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "for (int ${1:i} = 0; ${1:i} < ${2:limite}; ${1:i}++) {",
            "\t$0",
            "}"
        ],
        "description": "Loop for clássico de 3 cláusulas"
    },
    "For In Loop": {
        "prefix": "forin",
        "body": [
            "for (${1:item} in ${2:colecao}) {",
            "\t$0",
            "}"
        ],
        "description": "Loop for..in moderno sobre coleções"
    },
    "For In Indices": {
        "prefix": "foridx",
        "body": [
            "for (${1:indice} in ${2:colecao}.indices) {",
            "\t$0",
            "}"
        ],
        "description": "Loop for..in iterando pelos índices da coleção"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while (${1:condicao}) {",
            "\t$0",
            "}"
        ],
        "description": "Loop de repetição while"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condicao}) {",
            "\t$0",
            "}"
        ],
        "description": "Condicional if"
    },
    "If-Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if (${1:condicao}) {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "Condicional if..else"
    },
    "Ternary Operator": {
        "prefix": "ternary",
        "body": [
            "(${1:condicao}) ? ${2:valor_se_verdadeiro} : ${3:valor_se_falso}"
        ],
        "description": "Operador ternário condicional"
    },
    "Runoff (Print)": {
        "prefix": "runoff",
        "body": [
            "runoff(${1:mensagem});"
        ],
        "description": "Função nativa primária de saída Kaz runoff()"
    },
    "Network Ping": {
        "prefix": "netping",
        "body": [
            "int ${1:lat} = net.ping(\"${2:1.1.1.1}\", ${3:53}, ${4:1000});"
        ],
        "description": "Medição de latência TCP com net.ping()"
    },
    "HTTP GET": {
        "prefix": "httpget",
        "body": [
            "string ${1:resposta} = net.http_get(\"${2:http://exemplo.com/api}\");"
        ],
        "description": "Requisição HTTP GET com net.http_get()"
    },
    "Try Catch Statement": {
        "prefix": "try",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:erro}) {",
            "\trunoff(\"Erro capturado: \", ${2:erro});",
            "\t$0",
            "}"
        ],
        "description": "Tratamento robusto de exceções try / catch"
    },
    "Native Test Block": {
        "prefix": "test",
        "body": [
            "test \"${1:nome do teste}\" {",
            "\tassert(${2:condicao}, \"${3:mensagem em caso de falha}\");",
            "\t$0",
            "}"
        ],
        "description": "Bloco de teste unitário nativo da linguagem Kaz"
    },
    "SQLite Database Connection": {
        "prefix": "dbopen",
        "body": [
            "int ${1:conn} = db.open(\"${2::memory:}\");",
            "db.execute(${1:conn}, \"${3:CREATE TABLE tabela (id INTEGER PRIMARY KEY);}\");",
            "$0",
            "db.close(${1:conn});"
        ],
        "description": "Abertura e manipulação de banco SQLite nativo"
    },
    "JSON Parse": {
        "prefix": "jsonparse",
        "body": [
            "any ${1:dados} = json.parse(${2:json_string});"
        ],
        "description": "Desserialização de JSON nativa com json.parse()"
    }
}
