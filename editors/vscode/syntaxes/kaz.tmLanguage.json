{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Kaz",
    "scopeName": "source.kaz",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#null" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#function_declaration" },
        { "include": "#function_call" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.kaz",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.kaz",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.kaz",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.kaz",
                            "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.kaz",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.kaz",
                            "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.kaz",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.kaz",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.float.kaz",
                    "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.kaz",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.kaz",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "null": {
            "patterns": [
                {
                    "name": "constant.language.null.kaz",
                    "match": "\\b(null)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.kaz",
                    "match": "\\b(if|else|for|in|while|break|continue|return|test|try|catch|match)\\b"
                },
                {
                    "name": "storage.type.function.kaz",
                    "match": "\\b(function)\\b"
                },
                {
                    "name": "storage.type.struct.kaz",
                    "match": "\\b(struct)\\b"
                },
                {
                    "name": "storage.type.enum.kaz",
                    "match": "\\b(enum)\\b"
                },
                {
                    "name": "keyword.control.import.kaz",
                    "match": "\\b(import)\\b"
                },
                {
                    "name": "storage.modifier.kaz",
                    "match": "\\b(const|let)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.kaz",
                    "match": "\\b(int|float|double|string|char|bool|bol|void|any|array|null)\\b"
                },
                {
                    "match": "\\b(array)\\s*(\\[)",
                    "captures": {
                        "1": { "name": "storage.type.array.kaz" },
                        "2": { "name": "punctuation.bracket.kaz" }
                    }
                },
                {
                    "name": "entity.name.type.struct.kaz",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.io.kaz",
                    "match": "\\b(runoff|println|print|input|read_line|assert)\\b"
                },
                {
                    "name": "support.function.builtin.convert.kaz",
                    "match": "\\b(to_int|to_float|to_string|to_bool|type_of)\\b"
                },
                {
                    "name": "support.function.builtin.system.kaz",
                    "match": "\\b(time_now|time_now_ms|time_now_secs|sleep|sleep_ms)\\b"
                },
                {
                    "name": "support.function.builtin.fs.kaz",
                    "match": "\\b(file_read|file_write|file_append|file_exists|file_delete)\\b"
                },
                {
                    "name": "support.function.db.kaz",
                    "match": "\\b(db_open|db_execute|db_query|db_close)\\b"
                },
                {
                    "name": "support.function.json.kaz",
                    "match": "\\b(json_parse|json_stringify)\\b"
                },
                {
                    "name": "support.function.fs.kaz",
                    "match": "\\b(fs_mkdir|fs_read|fs_write|fs_append|fs_exists|fs_remove|fs_read_dir|fs_copy|fs_size)\\b"
                },
                {
                    "name": "support.function.net.kaz",
                    "match": "\\b(net_ping|net_http_get|net_http_post|net_tcp_send)\\b"
                },
                {
                    "name": "support.class.namespace.kaz",
                    "match": "\\b(math|net|db|json|crypto|regex|fs)\\b(?=\\.)"
                },
                {
                    "name": "support.function.math.kaz",
                    "match": "(?<=\\bmath\\.)(sqrt|pow|abs|random|sin|cos|tan|floor|ceil|round|min|max)\\b"
                },
                {
                    "name": "support.function.net.kaz",
                    "match": "(?<=\\bnet\\.)(ping|http_get|http_post|tcp_send)\\b"
                },
                {
                    "name": "support.function.db.kaz",
                    "match": "(?<=\\bdb\\.)(open|execute|query|close)\\b"
                },
                {
                    "name": "support.function.json.kaz",
                    "match": "(?<=\\bjson\\.)(parse|stringify)\\b"
                },
                {
                    "name": "support.function.crypto.kaz",
                    "match": "(?<=\\bcrypto\\.)(sha256|md5|base64_encode|base64_decode)\\b"
                },
                {
                    "name": "support.function.regex.kaz",
                    "match": "(?<=\\bregex\\.)(is_match|find|replace)\\b"
                },
                {
                    "name": "support.function.fs.kaz",
                    "match": "(?<=\\bfs\\.)(mkdir|read_dir|remove|copy|size|read|write|append|exists)\\b"
                },
                {
                    "name": "support.function.method.kaz",
                    "match": "(?<=\\.)(len|indices|push|pop|insert|remove|join|contains|reverse|upper|lower|trim|split|replace|substring|starts_with|ends_with|slice|size|toUpperCase|toLowerCase|indexOf|find|includes|startsWith|endsWith)\\b"
                },
                {
                    "name": "support.function.builtin.math.kaz",
                    "match": "\\b(abs|min|max|sqrt|pow)\\b"
                }
            ]
        },

        "function_declaration": {
            "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
            "captures": {
                "1": { "name": "storage.type.function.kaz" },
                "2": { "name": "entity.name.function.kaz" },
                "3": { "name": "punctuation.bracket.kaz" }
            }
        },
        "function_call": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "name": "entity.name.function.call.kaz"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.kaz",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.ternary.kaz",
                    "match": "\\?|:"
                },
                {
                    "name": "keyword.operator.arithmetic.kaz",
                    "match": "\\+\\+|\\-\\-|\\+|\\-|\\*|\\/|\\%"
                },
                {
                    "name": "keyword.operator.bitwise.kaz",
                    "match": "<<|>>|&|\\||\\^|~"
                },
                {
                    "name": "keyword.operator.comparison.kaz",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.kaz",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.kaz",
                    "match": "<<=|>>=|\\+=|\\-=|\\*=|\\/=|%=|&=|\\|=|\\^=|="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.kaz",
                    "match": ";|,"
                },
                {
                    "name": "punctuation.accessor.kaz",
                    "match": "::|\\."
                },
                {
                    "name": "punctuation.bracket.kaz",
                    "match": "[\\{\\}\\(\\)\\[\\]]"
                }
            ]
        }
    }
}
