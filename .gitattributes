# Ignora scripts de automacao e documentacao da barra de linguagens
*.ps1 linguist-detectable=false
*.bat linguist-detectable=false
*.sh  linguist-detectable=false
scripts/** linguist-detectable=false
docs/** linguist-documentation=true

# Codigo Kaz marcado com a sintaxe nativa C para highlight imediato
*.kaz linguist-detectable=true
*.kaz linguist-language=C
