// ====================================================================
// Demonstração de Tratamento Robusto de Erros (try / catch) na Kaz
// ====================================================================

function calcular_desconto(int valor, int divisor): int {
    // Operação sujeita a divisão por zero
    return valor / divisor;
}

function processar_pagamento(string nome, int valor, int parcelas) {
    runoff("-> Iniciando processamento para: " + nome);
    int resultado = calcular_desconto(valor, parcelas);
    runoff("   Valor por parcela: R$ " + resultado);
}

function Main() {
    runoff("==================================================");
    runoff("  Kaz - Demonstração de try / catch & Unwinding   ");
    runoff("==================================================\n");

    // 1. Captura de divisão por zero através de chamadas de funções
    runoff("[Cenário 1] Tratamento de exceção em pilha de chamadas:");
    try {
        processar_pagamento("Empresa Alpha", 1500, 0);
        runoff("Esta linha NÃO será impressa!");
    } catch (err) {
        runoff("   [RECUPERADO] Falha interceptada: " + err);
    }
    runoff("   Fluxo restabelecido normalmente.\n");

    // 2. Captura de erro em I/O de arquivo
    runoff("[Cenário 2] Tratamento de leitura de arquivo inexistente:");
    try {
        string conteudo = fs_read("arquivo_inexistente_12345.log");
        runoff("Conteúdo lido: " + conteudo);
    } catch (e) {
        runoff("   [RECUPERADO] Erro de arquivo: " + e);
    }
    runoff("   Aplicação continuou sem crashar.\n");

    // 3. Bloco try / catch aninhado
    runoff("[Cenário 3] Blocos aninhados de recuperação:");
    try {
        runoff("   Entrando no bloco externo...");
        try {
            int falha_interna = 50 / 0;
        } catch (erro_interno) {
            runoff("   -> Interceptado no catch interno: " + erro_interno);
        }
        runoff("   Bloco externo continua após recuperação interna!");
    } catch (erro_externo) {
        runoff("   Catch externo: " + erro_externo);
    }

    // 4. Catch silencioso (sem declaração de variável)
    runoff("\n[Cenário 4] Catch silencioso sem variável de erro:");
    try {
        int x = 10 / 0;
    } catch {
        runoff("   Erro suprimido e fluxo desviado com segurança!");
    }

    runoff("\n==================================================");
    runoff("  Todos os testes de try / catch foram concluídos! ");
    runoff("==================================================");
}
