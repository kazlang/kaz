// tokenizer.kaz - WordPiece Tokenizer in Pure Kaz
// Implements vocabulary loading, lookup, and subword encoding (BERT / Hugging Face compatible)

function test_tokenizer(): int {
    string vocab_path = "/home/armando/Projetos/kaz/models/minilm/vocab.txt";
    if (!file_exists(vocab_path)) {
        runoff("[-] Error: Vocabulary file not found: " + vocab_path);
        return 1;
    }

    int t0 = time_now_ms();
    int tok = tokenizer_load(vocab_path);
    int t1 = time_now_ms();
    runoff("[+] Tokenizer loaded in " + (t1 - t0) + " ms. Handle: " + tok);
    runoff("    Vocab size: " + tokenizer_vocab_size(tok));

    runoff("    [CLS] id: " + tokenizer_token_to_id(tok, "[CLS]"));
    runoff("    hello id: " + tokenizer_token_to_id(tok, "hello"));
    runoff("    world id: " + tokenizer_token_to_id(tok, "world"));
    runoff("    Token 101: " + tokenizer_id_to_token(tok, 101));
    runoff("    Token 7592: " + tokenizer_id_to_token(tok, 7592));

    string sample = "hello world kaz";
    array[int] tokens = tokenizer_encode(tok, sample);
    runoff("[+] Encoded '" + sample + "': " + tokens.length() + " tokens");
    int i = 0;
    while (i < tokens.length()) {
        runoff("    token " + i + " -> id: " + tokens[i] + " (" + tokenizer_id_to_token(tok, tokens[i]) + ")");
        i = i + 1;
    }

    tokenizer_free(tok);
    runoff("[+] Tokenizer released successfully!");
    return 0;
}

function main(): int {
    runoff("=== Tokenizer Test ===");
    return test_tokenizer();
}
