// bench_speed.kaz - Pure Autoregressive Decode Speed Benchmark for Kaz Models
// Protocol: -p 0 (single prompt token), -n 64 decode steps, 5 repetitions, mean ± std.
// Usage: kaz run examples/ai/bench_speed.kaz -- <model.kzm> [repetitions=5] [tokens=64]

function vector_add(int out_buf, int a_buf, int b_buf, int n): int {
    return vec_add_f32(out_buf, a_buf, b_buf, n);
}

function vector_copy(int dst, int dst_elem_off, int src, int src_elem_off, int n): int {
    return vec_copy_f32(dst, dst_elem_off, src, src_elem_off, n);
}

function silu_mul(int out_buf, int gate_buf, int up_buf, int n): int {
    return silu_mul_f32(out_buf, gate_buf, up_buf, n);
}

function infer_rows_from_bytes(int byte_size, int cols, int qtype): int {
    if (byte_size <= 0 || cols <= 0) { return 0; }
    int bpr = (cols + 31) / 32;
    if (qtype == 0) { return byte_size / (cols * 4); }
    if (qtype == 1) { return byte_size / (cols * 2); }
    if (qtype == 2) { return byte_size / (bpr * 34); }
    if (qtype == 3) { return byte_size / (bpr * 18); }
    if (qtype == 4) { return byte_size / (bpr * 14); }
    if (qtype == 5) { return byte_size / (bpr * 12); }
    return byte_size / (cols * 4);
}

function run_bench(): int {
    int idx = 0;
    if (args_len() > 0 && argv(0) == "--") { idx = 1; }
    if (args_len() <= idx) {
        runoff("[-] Usage: kaz run examples/ai/bench_speed.kaz -- <model.kzm> [repetitions=5] [tokens=64]");
        return 1;
    }

    string model_path = argv(idx);
    int reps = 5;
    if (args_len() > idx + 1) { reps = to_int(argv(idx + 1)); }
    int n_tokens = 64;
    if (args_len() > idx + 2) { n_tokens = to_int(argv(idx + 2)); }
    int threads = 4;
    if (args_len() > idx + 3) { threads = to_int(argv(idx + 3)); }

    int m = model_open(model_path);
    if (m <= 0) {
        runoff("[-] Failed to open model: " + model_path);
        return 1;
    }

    int num_layers = kzm_layers(m);
    int dim = kzm_dim(m);
    int heads = kzm_heads(m);
    int vocab = kzm_vocab(m);
    int hd = dim / heads;

    int has_in_ln = 0;
    if (kzm_tensor_ptr(m, "model.layers.0.input_layernorm.weight") != 0) { has_in_ln = 1; }
    int has_post_ffn_ln = 0;
    if (kzm_tensor_ptr(m, "model.layers.0.post_feedforward_layernorm.weight") != 0) { has_post_ffn_ln = 1; }
    int has_q_norm = 0;
    if (kzm_tensor_ptr(m, "model.layers.0.self_attn.q_norm.weight") != 0) { has_q_norm = 1; }
    int has_fused_qkv = 0;
    if (kzm_tensor_ptr(m, "model.layers.0.self_attn.qkv_proj.weight") != 0) { has_fused_qkv = 1; }
    int has_fused_gu = 0;
    if (kzm_tensor_ptr(m, "model.layers.0.mlp.gate_up_proj.weight") != 0) { has_fused_gu = 1; }

    int kv_dim = dim;
    int qkv_rows = dim * 3;
    if (has_fused_qkv == 1) {
        int qkv_qt = kzm_tensor_qtype(m, "model.layers.0.self_attn.qkv_proj.weight");
        int qkv_bytes = kzm_tensor_size(m, "model.layers.0.self_attn.qkv_proj.weight");
        qkv_rows = infer_rows_from_bytes(qkv_bytes, dim, qkv_qt);
        kv_dim = (qkv_rows - dim) / 2;
    } else {
        int k_qt = kzm_tensor_qtype(m, "model.layers.0.self_attn.k_proj.weight");
        int k_bytes = kzm_tensor_size(m, "model.layers.0.self_attn.k_proj.weight");
        kv_dim = infer_rows_from_bytes(k_bytes, dim, k_qt);
    }
    int kv_heads = kv_dim / hd;
    if (kv_heads <= 0) { kv_heads = heads; }

    int inter_dim = 8192;
    int gu_rows = 16384;
    if (has_fused_gu == 1) {
        int gu_qt = kzm_tensor_qtype(m, "model.layers.0.mlp.gate_up_proj.weight");
        int gu_bytes = kzm_tensor_size(m, "model.layers.0.mlp.gate_up_proj.weight");
        gu_rows = infer_rows_from_bytes(gu_bytes, dim, gu_qt);
        inter_dim = gu_rows / 2;
    } else {
        int g_qt = kzm_tensor_qtype(m, "model.layers.0.mlp.gate_proj.weight");
        int g_bytes = kzm_tensor_size(m, "model.layers.0.mlp.gate_proj.weight");
        inter_dim = infer_rows_from_bytes(g_bytes, dim, g_qt);
    }

    int rot_dim = hd;
    float rope_theta = 500000.0;
    int w_emb = kzm_tensor_ptr(m, "model.embed_tokens.weight");
    int qt_emb = kzm_tensor_qtype(m, "model.embed_tokens.weight");
    int w_final_norm = kzm_tensor_ptr(m, "model.norm.weight");
    int qt_final_norm = kzm_tensor_qtype(m, "model.norm.weight");
    int w_head = kzm_tensor_ptr(m, "lm_head.weight");
    int qt_head = kzm_tensor_qtype(m, "lm_head.weight");
    if (w_head == 0) { w_head = w_emb; qt_head = qt_emb; }

    array[int] w_in_ln = []; array[int] qt_in_ln = [];
    array[int] w_qkv = [];   array[int] qt_qkv = [];
    array[int] wq = [];      array[int] qt_q = [];
    array[int] wk = [];      array[int] qt_k = [];
    array[int] wv = [];      array[int] qt_v = [];
    array[int] wqn = [];     array[int] qt_qn = [];
    array[int] wkn = [];     array[int] qt_kn = [];
    array[int] wo = [];      array[int] qt_o = [];
    array[int] wpa = [];     array[int] qt_pa = [];
    array[int] w_gu = [];    array[int] qt_gu = [];
    array[int] wg = [];      array[int] qt_g = [];
    array[int] wu = [];      array[int] qt_u = [];
    array[int] wd = [];      array[int] qt_d = [];
    array[int] wpf = [];     array[int] qt_pf = [];

    int l = 0;
    while (l < num_layers) {
        string p = "model.layers." + to_string(l) + ".";
        w_in_ln.push(kzm_tensor_ptr(m, p + "input_layernorm.weight"));
        qt_in_ln.push(kzm_tensor_qtype(m, p + "input_layernorm.weight"));
        w_qkv.push(kzm_tensor_ptr(m, p + "self_attn.qkv_proj.weight"));
        qt_qkv.push(kzm_tensor_qtype(m, p + "self_attn.qkv_proj.weight"));
        wq.push(kzm_tensor_ptr(m, p + "self_attn.q_proj.weight"));
        qt_q.push(kzm_tensor_qtype(m, p + "self_attn.q_proj.weight"));
        wk.push(kzm_tensor_ptr(m, p + "self_attn.k_proj.weight"));
        qt_k.push(kzm_tensor_qtype(m, p + "self_attn.k_proj.weight"));
        wv.push(kzm_tensor_ptr(m, p + "self_attn.v_proj.weight"));
        qt_v.push(kzm_tensor_qtype(m, p + "self_attn.v_proj.weight"));
        wqn.push(kzm_tensor_ptr(m, p + "self_attn.q_norm.weight"));
        qt_qn.push(kzm_tensor_qtype(m, p + "self_attn.q_norm.weight"));
        wkn.push(kzm_tensor_ptr(m, p + "self_attn.k_norm.weight"));
        qt_kn.push(kzm_tensor_qtype(m, p + "self_attn.k_norm.weight"));
        wo.push(kzm_tensor_ptr(m, p + "self_attn.o_proj.weight"));
        qt_o.push(kzm_tensor_qtype(m, p + "self_attn.o_proj.weight"));
        wpa.push(kzm_tensor_ptr(m, p + "post_attention_layernorm.weight"));
        qt_pa.push(kzm_tensor_qtype(m, p + "post_attention_layernorm.weight"));
        w_gu.push(kzm_tensor_ptr(m, p + "mlp.gate_up_proj.weight"));
        qt_gu.push(kzm_tensor_qtype(m, p + "mlp.gate_up_proj.weight"));
        wg.push(kzm_tensor_ptr(m, p + "mlp.gate_proj.weight"));
        qt_g.push(kzm_tensor_qtype(m, p + "mlp.gate_proj.weight"));
        wu.push(kzm_tensor_ptr(m, p + "mlp.up_proj.weight"));
        qt_u.push(kzm_tensor_qtype(m, p + "mlp.up_proj.weight"));
        wd.push(kzm_tensor_ptr(m, p + "mlp.down_proj.weight"));
        qt_d.push(kzm_tensor_qtype(m, p + "mlp.down_proj.weight"));
        wpf.push(kzm_tensor_ptr(m, p + "post_feedforward_layernorm.weight"));
        qt_pf.push(kzm_tensor_qtype(m, p + "post_feedforward_layernorm.weight"));
        l = l + 1;
    }

    int max_seq = n_tokens + 64;
    int x_buf = buf_alloc(dim * 4);
    int in_buf = buf_alloc(dim * 4);
    int qkv_buf = buf_alloc(qkv_rows * 4);
    int q_buf = buf_alloc(dim * 4);
    int k_buf = buf_alloc(kv_dim * 4);
    int v_buf = buf_alloc(kv_dim * 4);
    int attn_buf = buf_alloc(dim * 4);
    int o_buf = buf_alloc(dim * 4);
    int gu_buf = buf_alloc(gu_rows * 4);
    int gate_buf = buf_alloc(inter_dim * 4);
    int up_buf = buf_alloc(inter_dim * 4);
    int act_buf = buf_alloc(inter_dim * 4);
    int down_buf = buf_alloc(dim * 4);
    int norm_buf = buf_alloc(dim * 4);
    int logits_buf = buf_alloc(vocab * 4);
    int k_cache_buf = buf_alloc(num_layers * max_seq * kv_dim * 4);
    int v_cache_buf = buf_alloc(num_layers * max_seq * kv_dim * 4);

    // Warmup 16 tokens
    int cur_token = 100;
    int pos = 0;
    while (pos < 16) {
        embed_lookup(w_emb, cur_token, x_buf, dim, qt_emb);
        l = 0;
        while (l < num_layers) {
            int attn_in = x_buf;
            if (has_in_ln == 1) { rms_norm_f32(in_buf, x_buf, w_in_ln[l], dim, qt_in_ln[l]); attn_in = in_buf; }
            if (has_fused_qkv == 1) {
                mat_vec_mul_auto(w_qkv[l], attn_in, qkv_buf, qkv_rows, dim, qt_qkv[l]);
                vector_copy(q_buf, 0, qkv_buf, 0, dim);
                vector_copy(k_buf, 0, qkv_buf, dim, kv_dim);
                vector_copy(v_buf, 0, qkv_buf, dim + kv_dim, kv_dim);
            } else {
                mat_vec_mul_auto(wq[l], attn_in, q_buf, dim, dim, qt_q[l]);
                mat_vec_mul_auto(wk[l], attn_in, k_buf, kv_dim, dim, qt_k[l]);
                mat_vec_mul_auto(wv[l], attn_in, v_buf, kv_dim, dim, qt_v[l]);
            }
            if (has_q_norm == 1) { rms_norm_f32(q_buf, q_buf, wqn[l], dim, qt_qn[l]); rms_norm_f32(k_buf, k_buf, wkn[l], kv_dim, qt_kn[l]); }
            attn_rope_gqa_f32(q_buf, k_buf, v_buf, k_cache_buf, v_cache_buf, attn_buf, l, pos, max_seq, heads, kv_heads, hd, rot_dim, rope_theta);
            mat_vec_mul_auto(wo[l], attn_buf, o_buf, dim, dim, qt_o[l]);
            int mlp_in = x_buf;
            if (has_in_ln == 1) { vector_add(x_buf, x_buf, o_buf, dim); rms_norm_f32(in_buf, x_buf, wpa[l], dim, qt_pa[l]); mlp_in = in_buf; }
            else { rms_norm_f32(o_buf, o_buf, wpa[l], dim, qt_pa[l]); vector_add(x_buf, x_buf, o_buf, dim); mlp_in = x_buf; }
            if (has_fused_gu == 1) {
                mat_vec_mul_auto(w_gu[l], mlp_in, gu_buf, gu_rows, dim, qt_gu[l]);
                vector_copy(gate_buf, 0, gu_buf, 0, inter_dim);
                vector_copy(up_buf, 0, gu_buf, inter_dim, inter_dim);
            } else {
                mat_vec_mul_auto(wg[l], mlp_in, gate_buf, inter_dim, dim, qt_g[l]);
                mat_vec_mul_auto(wu[l], mlp_in, up_buf, inter_dim, dim, qt_u[l]);
            }
            silu_mul(act_buf, gate_buf, up_buf, inter_dim);
            mat_vec_mul_auto(wd[l], act_buf, down_buf, dim, inter_dim, qt_d[l]);
            if (has_post_ffn_ln == 1) { rms_norm_f32(down_buf, down_buf, wpf[l], dim, qt_pf[l]); }
            vector_add(x_buf, x_buf, down_buf, dim);
            l = l + 1;
        }
        rms_norm_f32(norm_buf, x_buf, w_final_norm, dim, qt_final_norm);
        mat_vec_mul_auto(w_head, norm_buf, logits_buf, vocab, dim, qt_head);
        cur_token = argmax_f32(logits_buf, vocab);
        pos = pos + 1;
    }

    array[float] speeds = [];
    float sum_spd = 0.0;

    int r = 0;
    while (r < reps) {
        int t0 = time_now_ms();
        pos = 0;
        cur_token = 100;
        while (pos < n_tokens) {
            embed_lookup(w_emb, cur_token, x_buf, dim, qt_emb);
            l = 0;
            while (l < num_layers) {
                int attn_in = x_buf;
                if (has_in_ln == 1) { rms_norm_f32(in_buf, x_buf, w_in_ln[l], dim, qt_in_ln[l]); attn_in = in_buf; }
                if (has_fused_qkv == 1) {
                    mat_vec_mul_auto(w_qkv[l], attn_in, qkv_buf, qkv_rows, dim, qt_qkv[l]);
                    vector_copy(q_buf, 0, qkv_buf, 0, dim);
                    vector_copy(k_buf, 0, qkv_buf, dim, kv_dim);
                    vector_copy(v_buf, 0, qkv_buf, dim + kv_dim, kv_dim);
                } else {
                    mat_vec_mul_auto(wq[l], attn_in, q_buf, dim, dim, qt_q[l]);
                    mat_vec_mul_auto(wk[l], attn_in, k_buf, kv_dim, dim, qt_k[l]);
                    mat_vec_mul_auto(wv[l], attn_in, v_buf, kv_dim, dim, qt_v[l]);
                }
                if (has_q_norm == 1) { rms_norm_f32(q_buf, q_buf, wqn[l], dim, qt_qn[l]); rms_norm_f32(k_buf, k_buf, wkn[l], kv_dim, qt_kn[l]); }
                attn_rope_gqa_f32(q_buf, k_buf, v_buf, k_cache_buf, v_cache_buf, attn_buf, l, pos, max_seq, heads, kv_heads, hd, rot_dim, rope_theta);
                mat_vec_mul_auto(wo[l], attn_buf, o_buf, dim, dim, qt_o[l]);
                int mlp_in = x_buf;
                if (has_in_ln == 1) { vector_add(x_buf, x_buf, o_buf, dim); rms_norm_f32(in_buf, x_buf, wpa[l], dim, qt_pa[l]); mlp_in = in_buf; }
                else { rms_norm_f32(o_buf, o_buf, wpa[l], dim, qt_pa[l]); vector_add(x_buf, x_buf, o_buf, dim); mlp_in = x_buf; }
                if (has_fused_gu == 1) {
                    mat_vec_mul_auto(w_gu[l], mlp_in, gu_buf, gu_rows, dim, qt_gu[l]);
                    vector_copy(gate_buf, 0, gu_buf, 0, inter_dim);
                    vector_copy(up_buf, 0, gu_buf, inter_dim, inter_dim);
                } else {
                    mat_vec_mul_auto(wg[l], mlp_in, gate_buf, inter_dim, dim, qt_g[l]);
                    mat_vec_mul_auto(wu[l], mlp_in, up_buf, inter_dim, dim, qt_u[l]);
                }
                silu_mul(act_buf, gate_buf, up_buf, inter_dim);
                mat_vec_mul_auto(wd[l], act_buf, down_buf, dim, inter_dim, qt_d[l]);
                if (has_post_ffn_ln == 1) { rms_norm_f32(down_buf, down_buf, wpf[l], dim, qt_pf[l]); }
                vector_add(x_buf, x_buf, down_buf, dim);
                l = l + 1;
            }
            rms_norm_f32(norm_buf, x_buf, w_final_norm, dim, qt_final_norm);
            mat_vec_mul_auto(w_head, norm_buf, logits_buf, vocab, dim, qt_head);
            cur_token = argmax_f32(logits_buf, vocab);
            pos = pos + 1;
        }
        int ms = time_now_ms() - t0;
        float spd = (n_tokens * 1000.0) / (ms * 1.0);
        speeds.push(spd);
        sum_spd = sum_spd + spd;
        r = r + 1;
    }

    float mean = sum_spd / (reps * 1.0);
    float sum_sq_diff = 0.0;
    r = 0;
    while (r < reps) {
        float diff = speeds[r] - mean;
        sum_sq_diff = sum_sq_diff + (diff * diff);
        r = r + 1;
    }
    float std = sqrt(sum_sq_diff / (reps * 1.0));

    runoff("SPEED_RESULT|model=" + model_path + "|threads=" + to_string(threads) + "|mean=" + to_string(mean) + "|std=" + to_string(std));
    model_close(m);
    return 0;
}

run_bench();
