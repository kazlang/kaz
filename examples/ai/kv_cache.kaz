// kv_cache.kaz - Gerenciador de KV-Cache para Inferência Autoregressiva em Kaz
// Armazena tensores de Chave (K) e Valor (V) para cada camada da rede Transformer.

struct KVCache {
    int max_seq_len;
    int hidden_dim;
    int num_layers;
    int cur_seq_len;
    // Buffers lineares de bytes para K e V (armazenados como handles mmap/buf_alloc)
    int k_buf;
    int v_buf;
}

function kv_cache_init(int max_seq, int dim, int layers): KVCache {
    // Aloca buffers contíguos de f32: layers * max_seq * dim * 4 bytes
    int total_floats = layers * max_seq * dim;
    int total_bytes = total_floats * 4;
    int k_handle = buf_alloc(total_bytes);
    int v_handle = buf_alloc(total_bytes);

    println("[+] KV-Cache inicializado:");
    println("    Max Seq Len:", max_seq);
    println("    Hidden Dim:", dim);
    println("    Layers:", layers);
    println("    Memória por Buffer:", (total_bytes / 1024), "KB");

    return KVCache {
        max_seq_len: max_seq,
        hidden_dim: dim,
        num_layers: layers,
        cur_seq_len: 0,
        k_buf: k_handle,
        v_buf: v_handle
    };
}

function kv_cache_get_offset(KVCache cache, int layer, int pos): int {
    // offset = (layer * max_seq_len + pos) * hidden_dim * 4
    return (layer * cache.max_seq_len + pos) * cache.hidden_dim * 4;
}

function kv_cache_append(KVCache cache, int layer, int pos, int src_k_buf, int src_v_buf): int {
    int offset = kv_cache_get_offset(cache, layer, pos);
    int bytes = cache.hidden_dim * 4;

    // Copia vetor f32 de src para cache
    int i = 0;
    while (i < cache.hidden_dim) {
        float val_k = buf_load_f32_le(src_k_buf, i * 4);
        float val_v = buf_load_f32_le(src_v_buf, i * 4);
        buf_store_f32_le(cache.k_buf, offset + i * 4, val_k);
        buf_store_f32_le(cache.v_buf, offset + i * 4, val_v);
        i = i + 1;
    }
    return 0;
}

function kv_cache_free(KVCache cache): int {
    buf_free(cache.k_buf);
    buf_free(cache.v_buf);
    return 0;
}

function main(): int {
    println("=== Teste do KV-Cache ===");
    KVCache cache = kv_cache_init(512, 384, 12);
    
    // Cria vetores de teste
    int vec_k = buf_alloc(384 * 4);
    int vec_v = buf_alloc(384 * 4);
    buf_store_f32_le(vec_k, 0, 1.234);
    buf_store_f32_le(vec_v, 0, 5.678);

    kv_cache_append(cache, 0, 0, vec_k, vec_v);
    
    int off0 = kv_cache_get_offset(cache, 0, 0);
    println("K[layer=0, pos=0, d=0]:", buf_load_f32_le(cache.k_buf, off0));
    println("V[layer=0, pos=0, d=0]:", buf_load_f32_le(cache.v_buf, off0));

    buf_free(vec_k);
    buf_free(vec_v);
    kv_cache_free(cache);
    println("[+] KV-Cache liberado com sucesso!");
    return 0;
}
