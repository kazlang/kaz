// load_model.kaz
// Utility for zero-copy inspection, opening, and tensor mapping in Kaz
// Supports Kaz native model format (.kzm) and Hugging Face Safetensors (.safetensors) via mmap.

function print_separator(): int {
    runoff("================================================================================");
    return 0;
}

function inspect_and_load(string path): int {
    print_separator();
    runoff("  KAZ AI ENGINE - Zero-Copy Binary Model Loader");
    runoff("  Target File: " + path);
    print_separator();

    if (!file_exists(path)) {
        runoff("[-] Error: File not found: " + path);
        return 1;
    }

    int handle = model_open(path);
    if (handle <= 0) {
        runoff("[-] Error: Invalid or corrupt format. Unable to map via mmap.");
        return 1;
    }

    int mtype = model_type(handle);
    int fsize = model_size(handle);
    int size_mb = fsize / (1024 * 1024);

    runoff("[+] Model mapped successfully in virtual memory!");
    runoff("    Mmap Handle: " + handle);
    runoff("    File Size: " + size_mb + " MB (" + fsize + " bytes)");

    if (mtype == 1) {
        runoff("    Format Identified: Kaz Native Model (.kzm)");
        int layers = kzm_layers(handle);
        int dim = kzm_dim(handle);
        int heads = kzm_heads(handle);
        int vocab = kzm_vocab(handle);
        int tcount = kzm_tensor_count(handle);

        runoff("    --- Architecture Metadata ---");
        runoff("    Hidden Layers: " + layers);
        runoff("    Embedding Dimension: " + dim);
        runoff("    Attention Heads: " + heads);
        runoff("    Vocabulary Size: " + vocab);
        runoff("    Total Registered Tensors: " + tcount);

        // Tensor pointer resolution test
        runoff("    --- Tensor Pointer Resolution ---");
        int ptr_embed = kzm_tensor_ptr(handle, "model.embed");
        if (ptr_embed != 0) {
            int sz = kzm_tensor_size(handle, "model.embed");
            runoff("    [OK] Tensor 'model.embed' -> Memory Pointer: " + ptr_embed + " (" + sz + " bytes)");
            float w0 = buf_load_f32_le(ptr_embed, 0);
            float w1 = buf_load_f32_le(ptr_embed, 4);
            runoff("         First weights: [" + w0 + ", " + w1 + ", ...]");
        }
    } else if (mtype == 2) {
        runoff("    Format Identified: Hugging Face Safetensors (.safetensors)");
        
        // Tensor probe test
        runoff("    --- Safetensors Tensor Probe ---");
        array[string] candidate_tensors = [
            "embeddings.word_embeddings.weight",
            "model.embed_tokens.weight",
            "tok_embeddings.weight",
            "weight"
        ];
        
        int i = 0;
        while (i < candidate_tensors.length()) {
            string tname = candidate_tensors[i];
            int ptr = safetensors_tensor_ptr(handle, tname);
            if (ptr != 0) {
                int sz = safetensors_tensor_size(handle, tname);
                runoff("    [OK] Tensor Found: '" + tname + "' (" + sz + " bytes)");
                float f0 = buf_load_f32_le(ptr, 0);
                float f1 = buf_load_f32_le(ptr, 4);
                runoff("         Initial weights: [" + f0 + ", " + f1 + ", ...]");
            }
            i = i + 1;
        }
    } else {
        runoff("    Unknown Format");
    }

    model_close(handle);
    runoff("[+] Memory mapping closed successfully.");
    print_separator();
    return 0;
}

function main(): int {
    if (args_len() < 1) {
        string default_path = "/home/armando/Projetos/kaz/models/minilm/model.safetensors";
        if (file_exists(default_path)) {
            return inspect_and_load(default_path);
        }
        runoff("Usage: kaz run examples/ai/load_model.kaz -- <model_path.kzm_or_safetensors>");
        return 0;
    }

    string model_path = argv(0);
    return inspect_and_load(model_path);
}
