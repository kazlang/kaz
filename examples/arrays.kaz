// Exemplo: Arrays e Coleções em Kaz

array frutas = ["Maçã", "Banana", "Laranja", "Morango"];

runoff("=== Lista Inicial de Frutas ===");
runoff("Total de frutas: " + len(frutas));
for (int i = 0; i < len(frutas); i++) {
    runoff("  [" + i + "] " + frutas[i]);
}

runoff("\n=== Modificando elementos por índice ===");
frutas[1] = "Manga";
runoff("Elemento no índice 1 alterado para: " + frutas[1]);

runoff("\n=== Adicionando e Removendo Elementos ===");
frutas = push(frutas, "Abacaxi");
runoff("Após push(\"Abacaxi\"): " + arr_join(frutas, " -> "));

frutas = pop(frutas);
runoff("Após pop(): " + arr_join(frutas, " -> "));

runoff("\n=== Invertendo Array ===");
array invertido = arr_reverse(frutas);
runoff("Invertido: " + arr_join(invertido, " | "));
