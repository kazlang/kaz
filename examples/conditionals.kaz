// Exemplo: Estruturas Condicionais (if, else if, else) em Kaz

int nota = 85;

runoff("=== Classificação de Desempenho ===");
runoff("Nota do estudante: " + nota);

if (nota >= 90) {
    runoff("Conceito: A (Excelente!)");
} else if (nota >= 80) {
    runoff("Conceito: B (Muito Bom!)");
} else if (nota >= 70) {
    runoff("Conceito: C (Bom)");
} else if (nota >= 60) {
    runoff("Conceito: D (Regular)");
} else {
    runoff("Conceito: F (Reprovado)");
}

// Comparações lógicas compostas
int temperatura = 26;
bol esta_chovendo = false;

runoff("\n=== Avaliação de Clima ===");
if (temperatura > 20 && !esta_chovendo) {
    runoff("O clima está perfeito para passear no parque!");
} else if (temperatura <= 20 || esta_chovendo) {
    runoff("Melhor levar um agasalho ou guarda-chuva!");
}
