struct Ponto3D {
    float x;
    float y;
    float z;
}

function Main(): int {
    Ponto3D p = Ponto3D {
        x: 3.0,
        y: 4.0,
        z: 12.0
    };

    float dist = math.sqrt(p.x * p.x + p.y * p.y + p.z * p.z);
    runoff("Distância calculada nativamente via JIT:");
    runoff(dist);

    int t0 = time_now_ms();
    float soma = 0.0;
    for (int i = 1; i <= 10000; i++) {
        Ponto3D pt = Ponto3D {
            x: i * 1.0,
            y: i * 2.0,
            z: i * 3.0
        };
        soma = soma + math.sqrt(pt.x * pt.x + pt.y * pt.y + pt.z * pt.z);
    }
    int t_total = time_now_ms() - t0;
    runoff("Tempo para alocar 10.000 structs e calcular raiz:");
    runoff(t_total);
    runoff("Soma final:");
    runoff(soma);
    return 0;
}
