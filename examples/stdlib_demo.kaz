// Exemplo: Recursos da Biblioteca Padrão Kaz

runoff("=== 1. Matemática ===");
runoff("Raiz quadrada de 25 = " + sqrt(25.0));
runoff("2 elevado a 8 = " + pow(2.0, 8.0));
runoff("Valor absoluto de -99 = " + abs(-99));
runoff("Seno de 0.0 = " + sin(0.0));
runoff("Cosseno de 0.0 = " + cos(0.0));
runoff("Mínimo entre 42 e 17 = " + min(42, 17));
runoff("Máximo entre 42 e 17 = " + max(42, 17));

runoff("\n=== 2. Manipulação de Strings ===");
string frase = "  Linguagem Kaz com Rust  ";
runoff("Original: '" + frase + "'");
runoff("Trim: '" + str_trim(frase) + "'");
runoff("Maiúsculas: " + str_upper(frase));
runoff("Minúsculas: " + str_lower(frase));
runoff("Substituir 'Rust' por 'Super Performance': " + str_replace(frase, "Rust", "Super Performance"));

runoff("\n=== 3. Conversões de Tipos ===");
int num = to_int("500");
float flt = to_float("12.34");
string str = to_string(999);
runoff("Tipo de num: " + type_of(num) + " (valor: " + num + ")");
runoff("Tipo de flt: " + type_of(flt) + " (valor: " + flt + ")");
runoff("Tipo de str: " + type_of(str) + " (valor: " + str + ")");

runoff("\n=== 4. Sistema de Arquivos ===");
string temp_arquivo = "kaz_exemplo_saida.txt";
file_write(temp_arquivo, "Linha gravada automaticamente pelo Kaz!");
runoff("Arquivo criado? " + file_exists(temp_arquivo));
runoff("Conteúdo lido: " + file_read(temp_arquivo));
file_delete(temp_arquivo);
runoff("Arquivo limpo após teste.");
