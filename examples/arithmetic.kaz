// Exemplo: Expressões Aritméticas e Operadores em Kaz

int a = 20;
int b = 6;

int soma = a + b;
int subtracao = a - b;
int multiplicacao = a * b;
int divisao = a / b;
int resto = a % b;

runoff("=== Operações Aritméticas Básicas ===");
runoff(a + " + " + b + " = " + soma);
runoff(a + " - " + b + " = " + subtracao);
runoff(a + " * " + b + " = " + multiplicacao);
runoff(a + " / " + b + " = " + divisao);
runoff(a + " % " + b + " = " + resto);

runoff("\n=== Precedência e Agrupamento ===");
int sem_parenteses = 2 + 3 * 4;
int com_parenteses = (2 + 3) * 4;
runoff("2 + 3 * 4 = " + sem_parenteses);
runoff("(2 + 3) * 4 = " + com_parenteses);

runoff("\n=== Operadores de Atribuição Composta ===");
int pontuacao = 100;
pontuacao += 50;
runoff("Pontuação após += 50: " + pontuacao);
pontuacao *= 2;
runoff("Pontuação após *= 2: " + pontuacao);
pontuacao -= 20;
runoff("Pontuação após -= 20: " + pontuacao);
pontuacao /= 4;
runoff("Pontuação após /= 4: " + pontuacao);
