struct Ponto3D {
    float x;
    float y;
    float z;
}

function fib(int n): int {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

function Main() {
    runoff("╔══════════════════════════════════════════════════════════════════════╗");
    runoff("║               KAZ JIT (OTIMIZADO) - BENCHMARK SUITE                  ║");
    runoff("╚══════════════════════════════════════════════════════════════════════╝\n");

    // 1. Fibonacci(26)
    int t0_fib = time_now_us();
    int res_fib = fib(26);
    int t_fib = time_now_us() - t0_fib;
    runoff("→ Teste 1: Recursão Profunda - Fibonacci(26)");
    runoff("  • Resultado: fib(26) = " + res_fib);
    runoff("  • Tempo decorrido: " + t_fib + " us (" + (t_fib / 1000) + " ms)\n");

    // 2. Loop Aritmético (50.000 iterações)
    int t0_loop = time_now_us();
    float acumulador = 0.0;
    for (int i = 1; i <= 50000; i++) {
        acumulador += (i * 1.5) - (i / 2.0);
    }
    int t_loop = time_now_us() - t0_loop;
    runoff("→ Teste 2: Loop Aritmético (50.000 iterações)");
    runoff("  • Acumulador final: " + acumulador);
    runoff("  • Tempo decorrido:  " + t_loop + " us (" + (t_loop / 1000) + " ms)\n");

    // 3. Structs (10.000 instâncias) com Bump Arena e hardware sqrt
    int t0_struct = time_now_us();
    float soma_distancias = 0.0;
    for (int j = 1; j <= 10000; j++) {
        Ponto3D p = Ponto3D {
            x: j * 1.0,
            y: j * 2.0,
            z: j * 3.0
        };
        soma_distancias += math.sqrt(p.x * p.x + p.y * p.y + p.z * p.z);
    }
    int t_struct = time_now_us() - t0_struct;
    runoff("→ Teste 3: Criação e Manipulação de Structs (10.000 instâncias)");
    runoff("  • Soma das distâncias: " + soma_distancias);
    runoff("  • Tempo decorrido:     " + t_struct + " us (" + (t_struct / 1000) + " ms)\n");

    int t_total = t_fib + t_loop + t_struct;
    runoff("========================================================================");
    runoff("  RESULTADOS CONSOLIDADOS - KAZ CRANELIFT JIT 🦅");
    runoff("  • Recursão de CallFrames (Fib 26): " + t_fib + " us (" + (t_fib / 1000) + " ms)");
    runoff("  • Dispatch de Loop (50k ops):      " + t_loop + " us (" + (t_loop / 1000) + " ms)");
    runoff("  • Heap & Structs (10k instâncias): " + t_struct + " us (" + (t_struct / 1000) + " ms)");
    runoff("  • TEMPO TOTAL DA SUÍTE:            " + t_total + " us (" + (t_total / 1000) + " ms)");
    runoff("========================================================================\n");
}
