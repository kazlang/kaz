function main() {
    runoff("--- Iniciando Kaz-UI Toolkit & Kaz-X v2.0 Window Manager (100% Kaz) ---");
    kaz_x_init(1024, 768);
    runoff("Janela 1: " + g_winPainel.titulo);
    runoff("Janela 2: " + g_winTerm.titulo);
    runoff("Janela 3: " + g_winCalc.titulo);
    runoff("Janela 4: " + g_winNotes.titulo);
    runoff("Janela 5: " + g_winMon.titulo);

    calcDigito(4);
    calcDigito(2);
    calcDefinirOperador(1);
    calcDigito(8);
    calcIgual();
    runoff("Validacao KazCalc (42 + 8): " + to_string(g_calcVisor));
    runoff("--- Kaz-UI Core, Apps & Multi-Window Manager validados em Kaz puro! ---");
}
